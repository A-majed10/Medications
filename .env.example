# Copy to .env for `docker compose up`. Everything here is OPTIONAL — the app
# runs fully on the free scripted patient with no keys at all.

JWT_SECRET=dev-secret-change-me
FACULTY_CODE=osce-faculty

# Optional FREE-tier AI fallback (used only when no scripted reply matches).
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: enable "Sign in with Google" (same value used by API and web).
GOOGLE_CLIENT_ID=
