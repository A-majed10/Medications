# Copy to .env for `docker compose up`. Only ANTHROPIC_API_KEY is required to
# make the AI work; the rest have sensible local defaults.

ANTHROPIC_API_KEY=
JWT_SECRET=dev-secret-change-me
FACULTY_CODE=osce-faculty

# Optional: enable "Sign in with Google" (same value used by API and web).
GOOGLE_CLIENT_ID=

# Optional paid memberships (Stripe). Leave blank = no paywall, unlimited free.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
FREE_STATION_LIMIT=3
