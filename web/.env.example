# Copy to .env (or set in your host's dashboard) and fill in.

# Base URL of the backend API.
# Local dev: http://localhost:8080
# Production: your deployed API URL, e.g. https://hakim-api.up.railway.app
VITE_API_URL=http://localhost:8080

# Google OAuth client ID for "Sign in with Google".
# Must match GOOGLE_CLIENT_ID on the server. Leave blank to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
