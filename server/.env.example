# ---- Copy this file to .env and fill in the values ----

# Postgres connection string. Railway/Render/Supabase give you one of these.
# Local example: postgres://postgres:postgres@localhost:5432/hakim
DATABASE_URL=

# Set to "true" when your Postgres requires SSL (most hosted providers do).
PGSSL=true

# Long random secret used to sign login tokens. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Your Anthropic API key. The server uses this to talk to Claude on behalf
# of logged-in users, so it never reaches the browser.
ANTHROPIC_API_KEY=

# Google OAuth client ID (for "Sign in with Google"). Create one at
# https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web.
# The SAME value must be given to the web app as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Anyone who signs up (or upgrades) with this code becomes a faculty member,
# who can author/edit/delete stations and see student progress.
FACULTY_CODE=osce-faculty

# Comma-separated list of web origins allowed to call the API (CORS).
# Include your deployed web URL and localhost for development.
CORS_ORIGINS=http://localhost:5173

# Port the API listens on (hosts usually set this automatically).
PORT=8080
